# Local development uses Ollama. On Hugging Face Spaces, SPACE_ID selects FLAN-T5.
LLM_BACKEND=ollama
OLLAMA_MODEL=mistral:7b
OLLAMA_BASE_URL=http://localhost:11434

# Public FLAN-T5 model loaded inside the Space's Docker container.
HF_FLAN_MODEL=google/flan-t5-base

# Embeddings run locally in the app.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Qdrant Cloud. Leave blank to use process-local in-memory Qdrant.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=pdf_docs
